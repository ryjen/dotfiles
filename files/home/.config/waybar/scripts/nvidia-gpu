#!/usr/bin/env bash
set -euo pipefail

# Emit aggregate NVIDIA GPU utilization in Waybar, with per-GPU detail in the tooltip.
# Keep this script host-safe: non-NVIDIA machines should render nothing instead
# of causing repeated Waybar errors.
if ! command -v nvidia-smi >/dev/null 2>&1; then
  printf '{"text":"","tooltip":"nvidia-smi not found","class":"missing"}\n'
  exit 0
fi

query='index,utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw,power.limit,fan.speed,name'
if ! output="$(nvidia-smi --query-gpu="$query" --format=csv,noheader,nounits 2>/dev/null)"; then
  printf '{"text":"","tooltip":"nvidia-smi failed","class":"error"}\n'
  exit 0
fi

if [ -z "${output// }" ]; then
  printf '{"text":"","tooltip":"No NVIDIA GPU reported by nvidia-smi","class":"missing"}\n'
  exit 0
fi

trim() {
  local value="$1"
  value="${value#${value%%[![:space:]]*}}"
  value="${value%${value##*[![:space:]]}}"
  printf '%s' "$value"
}

json_escape() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '%s' "$value"
}

percent() {
  local used="$1"
  local total="$2"

  if [ -z "$used" ] || [ -z "$total" ] || [ "$total" = "0" ]; then
    printf '0'
    return
  fi

  awk -v used="$used" -v total="$total" 'BEGIN { printf "%d", (used * 100 / total) + 0.5 }'
}

tooltip=''
gpu_count=0
util_total=0
mem_used_total=0
mem_capacity_total=0

while IFS=',' read -r index util temp mem_used mem_total power power_limit fan name; do
  index="$(trim "$index")"
  util="$(trim "$util")"
  temp="$(trim "$temp")"
  mem_used="$(trim "$mem_used")"
  mem_total="$(trim "$mem_total")"
  power="$(trim "$power")"
  power_limit="$(trim "$power_limit")"
  fan="$(trim "$fan")"
  name="$(trim "$name")"
  vram_pct="$(percent "$mem_used" "$mem_total")"

  gpu_count=$((gpu_count + 1))
  util_total=$((util_total + util))
  mem_used_total=$((mem_used_total + mem_used))
  mem_capacity_total=$((mem_capacity_total + mem_total))

  if [ -n "$tooltip" ]; then
    tooltip+=$'\n\n'
  fi
  tooltip+="GPU ${index}: ${name}"$'\n'
  tooltip+="Utilization: ${util}%"$'\n'
  tooltip+="VRAM: ${vram_pct}% (${mem_used} / ${mem_total} MiB)"$'\n'
  tooltip+="Temp: ${temp}°C"$'\n'
  tooltip+="Power: ${power} / ${power_limit} W"$'\n'
  tooltip+="Fan: ${fan}%"
done <<< "$output"

aggregate_util="$(percent "$util_total" "$((gpu_count * 100))")"
aggregate_vram="$(percent "$mem_used_total" "$mem_capacity_total")"
text="󰢮  ${aggregate_util}%/${aggregate_vram}%"

printf '{"text":"%s","tooltip":"%s","class":"nvidia"}\n' \
  "$(json_escape "$text")" "$(json_escape "$tooltip")"

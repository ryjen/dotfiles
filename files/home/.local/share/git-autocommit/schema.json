{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "git-autocommit-plan/v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["message", "files"],
    "properties": {
      "message": {"type": "string", "minLength": 1},
      "files": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}

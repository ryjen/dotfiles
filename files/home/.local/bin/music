#!/usr/bin/env bash
set -euo pipefail

music_dir="${MPV_MUSIC_DIR:-${DUBNIUM_MUSIC_DIR:-$HOME/Music}}"

mpv_music_args=(
  --no-video
  --audio-display=no
  --loop-playlist=inf
  --save-position-on-quit
)

if [ "$#" -gt 0 ]; then
  exec mpv "${mpv_music_args[@]}" "$@"
fi

if [ ! -d "$music_dir" ]; then
  printf 'music directory not found: %s\n' "$music_dir" >&2
  exit 1
fi

exec mpv \
  "${mpv_music_args[@]}" \
  --shuffle \
  "$music_dir"

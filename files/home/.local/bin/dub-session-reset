#!/usr/bin/env bash
set -euo pipefail

# Reap compositor-owned surfaces before rebuilding the session. Waybar is owned
# by the managed unit and is canonicalized by dub-session-start, so it is not
# touched here.
pkill mako >/dev/null 2>&1 || true
pkill hyprpaper >/dev/null 2>&1 || true

exec "$HOME/.local/bin/dub-session-start"

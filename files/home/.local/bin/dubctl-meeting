#!/usr/bin/env bash
set -euo pipefail

version="dubctl-meeting 0.1.0"
libexec="$HOME/.local/libexec"

usage() {
  printf 'usage: dubctl meeting <command>\n'
  printf '\n'
  printf 'commands:\n'
  printf '  session    meeting session lifecycle (start, stop, status)\n'
  printf '  doctor     check meeting prerequisites and privacy status\n'
  printf '\n'
  printf 'run "dubctl meeting <command> --help" for command details\n'
}

case "${1-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --version)
    printf '%s\n' "$version"
    exit 0
    ;;
  session)
    shift
    exec dubctl-meeting-session "$@"
    ;;
  doctor)
    exec "$HOME/.local/bin/dub-session-doctor" "$@"
    ;;
  "")
    usage >&2
    exit 64
    ;;
  *)
    printf 'dubctl-meeting: unknown subcommand %s\n' "$1" >&2
    usage >&2
    exit 64
    ;;
esac

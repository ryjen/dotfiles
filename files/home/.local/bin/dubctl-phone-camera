#!/usr/bin/env bash
set -euo pipefail

VERSION="3"

usage() {
	cat <<'EOF'
Usage: dubctl-phone-camera [command] [scrcpy args...]

Commands:
  devices       List Linux video devices and ADB devices.
  cameras       List cameras on the single USB-connected Android device.
  front         Expose the front Android camera through v4l2loopback.
  back          Expose the back Android camera through v4l2loopback.
  --help        Show this help.
  --version     Show the helper version.

Native Android USB webcam mode does not require this helper. If Android offers
"Webcam" under USB preferences, select it and choose that /dev/video* device in
your application.

On Android 12+ the scrcpy fallback captures a phone camera directly. On Android
11 and older, scrcpy cannot capture cameras, so the helper mirrors the Android
display into the loopback device instead; open the camera app on the phone
screen to feed the meeting. The display fallback stays USB-only and audio-free.
On current Dubnium main, enable dubnium.videoMeeting.virtualCamera.enable
in NixOS to provide the loopback sink (normally /dev/video10).
This helper prefers /dev/dubnium-camera if present and otherwise discovers
a verified v4l2loopback device through sysfs.
Set DUBNIUM_PHONE_CAMERA_DEVICE=/dev/videoN to override all device discovery.
Set DUBNIUM_PHONE_CAMERA_MAX_SIZE=N to override the default 1920-pixel limit.
EOF
}

require_command() {
	if ! command -v "$1" >/dev/null 2>&1; then
		printf 'dubctl-phone-camera: required command not found: %s\n' "$1" >&2
		exit 127
	fi
}

find_loopback_device() {
	if [[ -n ${DUBNIUM_PHONE_CAMERA_DEVICE:-} ]]; then
		printf '%s\n' "$DUBNIUM_PHONE_CAMERA_DEVICE"
		return 0
	fi

	local stable_device="/dev/dubnium-camera"
	local resolved_device=""
	local resolved_name=""
	if [[ -e $stable_device ]]; then
		resolved_device="$(readlink -f -- "$stable_device" 2>/dev/null || true)"
		resolved_name="${resolved_device##*/}"
		if [[ $resolved_device == /dev/video* && -e "/sys/class/video4linux/$resolved_name/format" ]]; then
			printf '%s\n' "$stable_device"
			return 0
		fi
	fi

	local sysdev
	for sysdev in /sys/class/video4linux/video*; do
		[[ -e $sysdev ]] || continue
		# v4l2loopback exposes its per-device format control through this sysfs
		# attribute; physical V4L2 cameras do not use this loopback interface.
		[[ -e "$sysdev/format" ]] || continue
		printf '/dev/%s\n' "${sysdev##*/}"
		return 0
	done

	return 1
}

list_devices() {
	require_command v4l2-ctl
	require_command adb

	v4l2-ctl --list-devices
	printf '\nADB devices:\n'
	adb devices -l
}

list_cameras() {
	require_command scrcpy
	exec scrcpy --select-usb --list-cameras
}

device_sdk_level() {
	command -v adb >/dev/null 2>&1 || return 1
	local sdk
	sdk="$(adb -d shell getprop ro.build.version.sdk 2>/dev/null | tr -d '[:space:]')" || return 1
	[[ $sdk =~ ^[0-9]+$ ]] || return 1
	printf '%s' "$sdk"
}

start_camera() {
	local facing="$1"
	shift

	require_command scrcpy

	local sink
	if ! sink="$(find_loopback_device)"; then
		cat >&2 <<'EOF'
dubctl-phone-camera: no v4l2loopback device found.
Enable dubnium.videoMeeting.virtualCamera.enable on the NixOS host and rebuild,
or use Android's native USB Webcam mode if the phone exposes it.
EOF
		exit 2
	fi

	if [[ ! -e $sink ]]; then
		printf 'dubctl-phone-camera: configured camera sink does not exist: %s\n' "$sink" >&2
		exit 2
	fi

	local max_size="${DUBNIUM_PHONE_CAMERA_MAX_SIZE:-1920}"

	local sdk
	sdk="$(device_sdk_level 2>/dev/null || true)"
	if [[ -n $sdk && $sdk -lt 31 ]]; then
		cat >&2 <<EOF
dubctl-phone-camera: camera mirroring needs Android 12+ (device reports SDK $sdk).
Mirroring the Android display into $sink instead.
Open the camera app on the phone screen; the meeting sees that display.
Capture stays USB-only and audio-free.
EOF
		exec scrcpy \
			--select-usb \
			--video-source=display \
			--max-size="$max_size" \
			--v4l2-sink="$sink" \
			--no-audio \
			--no-playback \
			"$@"
	fi

	exec scrcpy \
		--select-usb \
		--video-source=camera \
		--camera-facing="$facing" \
		--max-size="$max_size" \
		--v4l2-sink="$sink" \
		--no-audio \
		--no-playback \
		"$@"
}

case "${1:-}" in
devices)
	list_devices
	;;
cameras)
	list_cameras
	;;
front | back)
	facing="$1"
	shift
	start_camera "$facing" "$@"
	;;
-h | --help | help)
	usage
	;;
--version)
	printf 'dubctl-phone-camera %s\n' "$VERSION"
	;;
"")
	usage >&2
	exit 2
	;;
*)
	printf 'dubctl-phone-camera: unknown command: %s\n\n' "$1" >&2
	usage >&2
	exit 2
	;;
esac

#!/usr/bin/env sh
set -eu

uv_tools_dir="${UV_TOOL_DIR:-${HOME}/.local/share/uv/tools}"

for candidate in \
  "${uv_tools_dir}/headroom-ai/bin/rtk" \
  "${uv_tools_dir}/headroom/bin/rtk" \
  "${uv_tools_dir}/headroom-ai-all/bin/rtk"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

if [ -d "$uv_tools_dir" ]; then
  found="$(find "$uv_tools_dir" -path '*/bin/rtk' -type f -perm -u+x -print 2>/dev/null | head -n 1 || true)"
  if [ -n "$found" ]; then
    exec "$found" "$@"
  fi
fi

printf '%s\n' "rtk: no executable rtk found under ${uv_tools_dir}; run configctl init apply uv-tools or inspect the Headroom uv tool environment" >&2
exit 127

#!/usr/bin/env bash
set -euo pipefail

music_playerctl="${MUSIC_PLAYERCTL:-$HOME/.local/bin/music-playerctl}"

if [ -x "$music_playerctl" ]; then
  player="$($music_playerctl --player-name 2>/dev/null || true)"

  if [ "$player" = "mpd" ]; then
    status="$($music_playerctl status 2>/dev/null || true)"

    case "$status" in
      Playing|Paused)
        exec "$music_playerctl" play-pause
        ;;
      Stopped)
        if command -v mpc >/dev/null 2>&1; then
          if [ -z "$(mpc playlist 2>/dev/null)" ]; then
            # A persistent MPD service can be available through MPRIS while
            # having no resumable queue. Seed the queue from the managed MPD
            # database so a Waybar click behaves like "start music" rather
            # than forwarding a play request that MPD cannot satisfy.
            mpc ls 2>/dev/null | mpc add >/dev/null

            if [ -n "$(mpc playlist 2>/dev/null)" ]; then
              mpc shuffle >/dev/null
            fi
          fi

          if [ -n "$(mpc playlist 2>/dev/null)" ]; then
            exec mpc play
          fi
        fi
        ;;
    esac
  elif [ -n "$player" ]; then
    exec "$music_playerctl" play-pause
  fi
fi

# Compatibility fallback for profiles that do not enable the managed MPD
# workflow and therefore do not install music-playerctl, or for an MPD
# instance whose database contains no playable tracks.
if playerctl --player=mpv status >/dev/null 2>&1; then
  exec playerctl --player=mpv play-pause
fi

music_cmd="$HOME/.local/bin/music"

if [ -x "$music_cmd" ]; then
  nohup "$music_cmd" >/dev/null 2>&1 &
elif command -v music >/dev/null 2>&1; then
  nohup music >/dev/null 2>&1 &
fi

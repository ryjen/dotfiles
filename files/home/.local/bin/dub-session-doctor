#!/usr/bin/env bash
set -u

status=0

ok() { printf '[ok] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*"; }
fail() { printf '[fail] %s\n' "$*"; status=1; }

check_file() {
  local path="$1"
  if [ -f "$path" ]; then
    ok "$path exists"
  else
    fail "$path missing"
  fi
}

check_dir() {
  local path="$1"
  if [ -d "$path" ]; then
    ok "$path exists"
  else
    fail "$path missing"
  fi
}

check_exe() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    ok "$name available"
  else
    fail "$name not found"
  fi
}

check_optional_exe() {
  local name="$1"
  if command -v "$name" >/dev/null 2>&1; then
    ok "$name available"
  else
    warn "$name not found"
  fi
}

printf 'Dubnium session doctor\n\n'

check_file "$HOME/.config/hypr/hyprland.conf"
check_dir "$HOME/.config/hypr/custom.d"
check_file "$HOME/.config/hypr/custom.d/00-empty.conf"
check_file "$HOME/.config/hypr/adopted.d/machine.conf"
check_file "$HOME/.config/waybar/config.jsonc"
check_file "$HOME/.config/waybar/style.css"
check_file "$HOME/.config/waybar/custom.css"
check_file "$HOME/.config/wofi/config"

for script in \
  dub-browser \
  dub-clipboard \
  dub-editor \
  dub-file-manager \
  dub-launch \
  dub-screenshot \
  dub-session-doctor \
  dub-session-reset \
  dub-session-start \
  dub-terminal \
  dub-waybar-reload; do
  path="$HOME/.local/bin/$script"
  if [ -x "$path" ]; then
    ok "$script executable"
  else
    fail "$script missing or not executable"
  fi
done

check_exe hyprland
check_exe waybar
check_exe alacritty
check_exe wofi
check_exe grim
check_exe slurp
check_exe wl-copy
check_exe wl-paste
check_exe cliphist
check_optional_exe rofi
check_optional_exe hyprpaper
check_optional_exe mako
check_optional_exe eww
check_optional_exe uwsm
check_optional_exe dolphin
check_optional_exe firefox
check_optional_exe code

if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet dubnium-cliphist.service; then
  ok 'cliphist service active'
else
  warn 'cliphist service not active'
fi

if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user is-enabled --quiet ssh-agent.service; then
    ok 'ssh-agent service enabled'
  else
    warn 'ssh-agent service not enabled'
  fi

  if systemctl --user is-active --quiet ssh-agent.service; then
    ok 'ssh-agent service active'
  else
    warn 'ssh-agent service not active'
  fi
else
  warn 'systemctl not available; cannot check ssh-agent service'
fi

if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
  ok "SSH_AUTH_SOCK available: $SSH_AUTH_SOCK"
else
  warn 'SSH_AUTH_SOCK is unset or does not name a socket'
fi

meeting_helper="$HOME/.local/libexec/dubnium-meeting-mode"
if [ -x "$meeting_helper" ]; then
  if meeting_status="$("$meeting_helper" status 2>/dev/null)"; then
    ok "meeting privacy status: $meeting_status"
  else
    warn 'meeting privacy status unavailable'
  fi
else
  warn 'meeting privacy helper not installed'
fi

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
log_file="$state_home/dubnium/session-start.log"
if [ -f "$log_file" ]; then
  ok "$log_file exists"
else
  warn "$log_file not found yet"
fi

if command -v fc-match >/dev/null 2>&1; then
  if fc-match 'JetBrainsMono Nerd Font' | grep -qi 'JetBrains'; then
    ok 'JetBrainsMono Nerd Font resolves'
  else
    warn 'JetBrainsMono Nerd Font may not resolve as expected'
  fi
else
  warn 'fc-match not available; cannot check font resolution'
fi

exit "$status"

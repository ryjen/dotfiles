#!/usr/bin/env bash
set -euo pipefail

playerctl_bin="${PLAYERCTL_BIN:-playerctl}"
status="$($playerctl_bin --player=mpd status 2>/dev/null || true)"

if [ -z "$status" ]; then
  python3 - <<'PY'
import json
print(json.dumps({
    "text": "■ stopped",
    "alt": "stopped",
    "class": "stopped",
    "tooltip": "Music is stopped\nOpen Music Library to choose a track or playlist",
}))
PY
  exit 0
fi

artist="$($playerctl_bin --player=mpd metadata xesam:artist 2>/dev/null || true)"
title="$($playerctl_bin --player=mpd metadata xesam:title 2>/dev/null || true)"
album="$($playerctl_bin --player=mpd metadata xesam:album 2>/dev/null || true)"
url="$($playerctl_bin --player=mpd metadata xesam:url 2>/dev/null || true)"
position="$($playerctl_bin --player=mpd position 2>/dev/null || true)"
length_us="$($playerctl_bin --player=mpd metadata mpris:length 2>/dev/null || true)"

python3 - "$status" "$artist" "$title" "$album" "$url" "$position" "$length_us" <<'PY'
import json
import os
import sys
import time

status, artist, title, album, url, position_raw, length_us_raw = sys.argv[1:8]
status = status.strip()
artist = artist.strip()
title = title.strip()
album = album.strip()

if artist and title:
    full_text = f"{artist} - {title}"
elif title:
    full_text = title
elif url:
    full_text = os.path.basename(url.rstrip("/")) or "MPD music"
else:
    full_text = "MPD music"

icon = {
    "Playing": "▶",
    "Paused": "⏸",
}.get(status, "■")

width = 36
if len(full_text) > width:
    padded = f"{full_text}   •   "
    offset = int(time.time()) % len(padded)
    track_text = (padded + padded)[offset:offset + width]
else:
    track_text = full_text


def parse_float(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def format_duration(seconds):
    if seconds is None or seconds < 0:
        return "--:--"
    total = int(seconds)
    hours, remainder = divmod(total, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes}:{secs:02d}"

position = parse_float(position_raw)
length_us = parse_float(length_us_raw)
length = length_us / 1_000_000 if length_us is not None else None

metadata_lines = [
    "Player: MPD",
    f"Status: {status}",
    f"Track: {title or full_text}",
]
if artist:
    metadata_lines.append(f"Artist: {artist}")
if album:
    metadata_lines.append(f"Album: {album}")
metadata_lines.append(f"Time: {format_duration(position)} / {format_duration(length)}")
metadata_lines.append("Music Library: manage queue and playlists")

print(json.dumps({
    "text": f"{icon} {track_text}",
    "alt": status.lower(),
    "class": status.lower(),
    "tooltip": "\n".join(metadata_lines),
}))
PY
